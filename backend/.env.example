# =====================================================================
# DearVoice backend 환경변수 예시
# - 이 파일을 backend/.env 로 복사한 뒤 값을 채워 사용합니다.
# - 실제 인증 정보는 절대 커밋하지 마세요. (.env 는 .gitignore 대상)
# - 아래 값은 모두 동작하지 않는 예시(placeholder)입니다.
# - 원본 저장소 이력에 노출된 SECRET_KEY 등은 재사용하지 말고 새로 발급하세요.
# =====================================================================

# ---------------------------------------------------------------------
# [필수] Django 기본
# ---------------------------------------------------------------------
# 새로 생성:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-generate-a-new-random-secret-key
# [선택] 기본 False
DEBUG=False
# [선택] 쉼표 구분, 기본 localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------
# [필수] 데이터베이스 (MySQL)
# ---------------------------------------------------------------------
DB_USER=dearvoice_dev
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
# [선택] 기본 dearvoice_db / 3306
DB_NAME=dearvoice_db
DB_PORT=3306

# ---------------------------------------------------------------------
# [필수] 프론트엔드 주소 / CORS
# - 이메일 공유 링크({FRONTEND_BASE_URL}/share/<id>) 생성 및 CORS 허용 Origin에 사용
# - Origin 형식(스킴+호스트+포트), 끝에 '/' 를 붙이지 마세요.
# ---------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
# [선택] 추가로 허용할 Origin (쉼표 구분). 빈 값은 무시됩니다.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# [기능: Celery / Redis] 예약 발송, AI 답장 비동기 처리
# [선택] 기본 redis://localhost:6379/0 (인증이 필요하면 redis://:password@host:port/0)
# ---------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------------
# [기능: AWS S3] 음성 업로드(/api/letters/upload/), AI 답장 음성 저장
# - 버킷 공개 설정이나 Public Access Block 해제는 하지 마세요.
# ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=ap-northeast-2

# ---------------------------------------------------------------------
# [기능: CLOVA Speech (STT)] /api/letters/transcribe/, /skyvoice/letters/transcribe/
# - 네이버 클라우드 콘솔 > CLOVA Speech > 도메인 > 빌더 실행 > 설정 에서 발급
# - 장문 인식(sync)만 사용하므로 Free 플랜 도메인으로 테스트 가능 (매월 20분 무료)
# - 서버에 FFmpeg 바이너리 필요 (webm -> wav 변환)
# ---------------------------------------------------------------------
CLOVA_SPEECH_INVOKE_URL=https://clovaspeech-gw.ncloud.com/external/v1/your-domain-id/your-invoke-hash
CLOVA_SPEECH_SECRET_KEY=your-clova-speech-secret-key

# ---------------------------------------------------------------------
# [기능: OpenAI] 하늘편지 AI 답장 생성
# ---------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key

# ---------------------------------------------------------------------
# [기능: Google Cloud TTS] 하늘편지 AI 답장 음성 합성
# - 서비스 계정 JSON 파일의 "경로"만 지정. JSON 파일 자체는 저장소 밖에 두고 커밋 금지.
# - google-cloud-texttospeech 라이브러리가 이 환경변수를 OS 환경에서 직접 읽습니다.
# ---------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/google-tts-service-account.json

# ---------------------------------------------------------------------
# [기능: Google 로그인] /api/auth/login/google/
# - GOOGLE_CLIENT_ID 는 공개 클라이언트 식별자. 프론트엔드 VITE_GOOGLE_CLIENT_ID 와 같은 값이어야 합니다.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---------------------------------------------------------------------
# [기능: SMTP 이메일] 편지 도착 알림 (Gmail SMTP, 앱 비밀번호 사용)
# ---------------------------------------------------------------------
EMAIL_HOST_USER=your-sender@example.com
EMAIL_HOST_PASSWORD=your-app-password

# ---------------------------------------------------------------------
# [미사용] settings.py 에서 읽지만 현재 코드에서 사용하지 않는 변수
# ---------------------------------------------------------------------
# GOOGLE_CLIENT_SECRET=      # Google ID 토큰 검증에는 불필요

# ---------------------------------------------------------------------
# [참고] 프론트엔드 (frontend/dearvoice/.env 에 별도 설정)
# ---------------------------------------------------------------------
# VITE_SERVER_API_URL=http://localhost:8000
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
